                        <div class="form-group">
                            <label for="message">MESSAGE：</label>
                            <textarea id="message" name="message"></textarea>
                        </div>
                        <button type="submit">SEND EMAIL</button>
                    </div>
                    <div class="contact-info">
                        <div class="info-item">
                            <h3>CONTACT INFORMATION</h3>
                            <p>TEL：19883131032</p>
                            <p>QQ：2242795950@qq.com</p>
                            <p>小红书号：llyrjxx07151129</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <script>
        (function(){
            const form = document.getElementById('siteSearchForm');
            const input = document.getElementById('siteSearchInput');
            let lastHighlights = [];

            function clearHighlights(){
                lastHighlights.forEach(el=> el.classList.remove('search-highlight'));
                lastHighlights = [];
            }

            function doSearch(q){
                clearHighlights();
                if(!q) return;
                const nodes = Array.from(document.querySelectorAll('h1,h2,h3,p,li'));
                const matches = nodes.filter(n=> n.textContent && n.textContent.toLowerCase().includes(q.toLowerCase()));
                if(matches.length === 0){
                    // 简单提示
                    alert('未找到匹配项');
                    return;
                }
                // 高亮前 6 个匹配项的元素
                matches.slice(0,6).forEach(el=>{ el.classList.add('search-highlight'); lastHighlights.push(el); });
                // 平滑滚动至首个匹配
                matches[0].scrollIntoView({behavior:'smooth', block:'center'});
            }

            form.addEventListener('submit', function(e){
                e.preventDefault();
                doSearch(input.value.trim());
            });

            // 按 ESC 清除高亮
            document.addEventListener('keydown', function(e){
                if(e.key === 'Escape') clearHighlights();
            });

            // 交互弹跳：点击时播放 .bounce-click 动画（在点击时临时添加类，动画结束后移除）
            document.addEventListener('pointerdown', function(e){
                const el = e.target.closest('button, .search-btn, .nav-links a');
                if(!el) return;
                // 重新触发动画（移除后强制重绘再添加）
                el.classList.remove('bounce-click');
                void el.offsetWidth;
                el.classList.add('bounce-click');
                function cleanup(){ el.classList.remove('bounce-click'); el.removeEventListener('animationend', cleanup); }
                el.addEventListener('animationend', cleanup);
            });
        })();
    </script>
</body>
</html>
